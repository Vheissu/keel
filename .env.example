DATABASE_URL=postgres://keel:keel-local-only@127.0.0.1:55439/keel
HOST=127.0.0.1
PORT=4040
ARTIFACT_PATH=./.data/artifacts
# npm run setup generates these. Never expose them through VITE_ variables.
KEEL_OPERATOR_TOKEN=
KEEL_APPROVER_TOKEN=

# Generated by setup; retain this key with encrypted connection records.
KEEL_CREDENTIAL_KEY=
# local or s3. API and artifact worker must use the same storage configuration.
ARTIFACT_STORE=local
# S3_BUCKET=keel-artifacts
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=keel-local
# AWS_SECRET_ACCESS_KEY=keel-local-storage-only

# Deployment services are started separately; see docs/deployment-agents.md.
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=keel-deployments
# AGENT_TLS_CERT=.data/agent-tls/server.crt
# AGENT_TLS_KEY=.data/agent-tls/server.key
# AGENT_TLS_CA=.data/agent-tls/ca.crt
# AGENT_HOST=127.0.0.1
# AGENT_PORT=4041
